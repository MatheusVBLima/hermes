generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id               String    @id
  name             String
  welcomeChannelId String?
  welcomeMessage   String?
  logChannelId     String?
  logMessages      Boolean   @default(false)
  logMembers       Boolean   @default(false)
  logModeration    Boolean   @default(false)
  logVoice         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  modLogs          ModLog[]
  warnings         Warning[]
}

model Warning {
  id          Int      @id @default(autoincrement())
  userId      String
  username    String
  guildId     String
  moderatorId String
  moderator   String
  reason      String
  createdAt   DateTime @default(now())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId, guildId])
}

model ModLog {
  id           Int      @id @default(autoincrement())
  guildId      String
  action       String
  targetId     String
  targetTag    String
  moderatorId  String
  moderatorTag String
  reason       String?
  duration     String?
  metadata     String?
  createdAt    DateTime @default(now())
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([targetId])
}

model UserLevel {
  id        Int      @id @default(autoincrement())
  userId    String
  guildId   String
  xp        Int      @default(0)
  level     Int      @default(0)
  lastXpAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([guildId, xp])
}

model LevelRole {
  id        Int      @id @default(autoincrement())
  guildId   String
  level     Int
  roleId    String
  createdAt DateTime @default(now())

  @@unique([guildId, level])
  @@index([guildId])
}

model XPSettings {
  id              Int      @id @default(autoincrement())
  guildId         String   @unique
  xpEnabled       Boolean  @default(true)
  xpMin           Int      @default(15)
  xpMax           Int      @default(25)
  xpCooldown      Int      @default(60000)
  levelUpMessage  Boolean  @default(true)
  ignoredChannels String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserEconomy {
  id        Int             @id @default(autoincrement())
  userId    String
  guildId   String
  balance   Int             @default(0)
  lastDaily DateTime?
  lastWork  DateTime?
  lastRob   DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  inventory UserInventory[]

  @@unique([userId, guildId])
  @@index([guildId, balance])
}

model ShopItem {
  id          Int      @id @default(autoincrement())
  guildId     String
  name        String
  description String?
  price       Int
  itemType    String
  roleId      String?
  emoji       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId])
}

model UserInventory {
  id         Int         @id @default(autoincrement())
  userId     String
  guildId    String
  itemId     Int
  itemName   String
  quantity   Int         @default(1)
  acquiredAt DateTime    @default(now())
  economy    UserEconomy @relation(fields: [userId, guildId], references: [userId, guildId], onDelete: Cascade)

  @@unique([userId, guildId, itemId])
  @@index([userId, guildId])
}

model ReactionRole {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String
  emoji     String
  roleId    String
  createdAt DateTime @default(now())

  @@unique([messageId, emoji])
  @@index([guildId])
  @@index([messageId])
}

model Giveaway {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String   @unique
  hostId    String
  prize     String
  winners   Int      @default(1)
  endsAt    DateTime
  ended     Boolean  @default(false)
  winnerIds String?
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([endsAt])
}

model AutoMod {
  id                 Int      @id @default(autoincrement())
  guildId            String   @unique
  antiSpamEnabled    Boolean  @default(false)
  antiSpamThreshold  Int      @default(5)
  antiSpamInterval   Int      @default(5000)
  antiSpamAction     String   @default("timeout")
  antiFloodEnabled   Boolean  @default(false)
  antiFloodThreshold Int      @default(3)
  antiFloodAction    String   @default("delete")
  antiLinkEnabled    Boolean  @default(false)
  antiLinkAction     String   @default("delete")
  allowedLinks       String?
  badWordsEnabled    Boolean  @default(false)
  badWordsList       String?
  badWordsAction     String   @default("delete")
  ignoredChannels    String?
  ignoredRoles       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Starboard {
  id              Int              @id @default(autoincrement())
  guildId         String           @unique
  channelId       String?
  threshold       Int              @default(3)
  emoji           String           @default("⭐")
  selfStar        Boolean          @default(false)
  enabled         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  starredMessages StarredMessage[]
}

model StarredMessage {
  id             Int       @id @default(autoincrement())
  guildId        String
  channelId      String
  messageId      String    @unique
  starboardMsgId String?
  authorId       String
  stars          Int       @default(0)
  content        String?
  attachments    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  starboard      Starboard @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@index([messageId])
}

model Reminder {
  id        Int      @id @default(autoincrement())
  userId    String
  guildId   String?
  channelId String
  message   String
  remindAt  DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([remindAt, completed])
}
