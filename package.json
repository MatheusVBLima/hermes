{
  "name": "hermes",
  "version": "1.0.0",
  "description": "A modern, feature-rich Discord bot built with TypeScript and Discord.js v14",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "deploy-commands:guild": "tsx src/deploy-commands.ts --guild",
    "check": "tsx scripts/check-setup.ts",
    "postinstall": "patch-package"
  },
  "keywords": [
    "discord",
    "bot",
    "discord-bot",
    "typescript",
    "discord.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@distube/yt-dlp": "^2.0.1",
    "@prisma/client": "^6.18.0",
    "@snazzah/davey": "^0.1.7",
    "discord.js": "^14.14.1",
    "distube": "^5.0.7",
    "dotenv": "^16.4.1",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "prisma": "^6.18.0",
    "sodium-native": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "nodemon": "^3.0.3",
    "patch-package": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
